                ]
              },
              "metadata": {
                "operationMetadataId": "30024c3f-30af-4d21-ad3f-9d12a329fc6b"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://70kv6sv.sharepoint.com/sites/DControlMonitoring",
                  "table": "0a3f8bd7-58e6-443c-851b-31104aca6b10",
                  "item/Title": "@{outputs('Compose_Title')} ",
                  "item/MonitoringStepsID": "@items('Apply_to_each')?['MonitoringStepID']",
                  "item/RunDate": "@utcNow()",
                  "item/ResultStatus/Value": "Pass",
                  "item/ResultDetails": "Sandbox monitoring check completed successfully"
                },
                "authentication": {
                  "type": "Raw",
                  "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                }
              }
            },
            "Update_item": {
              "runAfter": {
                "Create_item": [
                  "Succeeded"
